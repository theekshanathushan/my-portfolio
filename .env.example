# GitHub Personal Access Token (classic or fine-grained with read:user / public_repo permissions)
# Used exclusively by the serverless backend endpoint (/api/activity). NEVER expose on client.
GITHUB_TOKEN=your_token_here

# (Optional) Formspree ID or Resend API key for contact endpoint
# VITE_FORMSPREE_ID=your_formspree_id_here
# RESEND_API_KEY=your_resend_api_key_here
